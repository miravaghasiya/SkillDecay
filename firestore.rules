rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User profile and nested user documents
    match /users/{userId} {
      allow read, write: if owner(userId);

      match /{document=**} {
        allow read, write: if owner(userId);
      }
    }

    // Top-level study plans used by the app.
    match /study_plans/{planId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Explicitly deny anything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
